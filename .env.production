# ========================================
# PRODUCCIÓN - Hostinger estrategia.site
# ========================================

# Base de Datos PostgreSQL (Hostinger)
DATABASE_URL=postgresql://ebooksadmin:TU_PASSWORD_AQUI@localhost:5432/ebooks_store_prod

# Seguridad - CAMBIAR A ALGO ALEATORIO Y SEGURO
# Usa: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=tu-clave-aleatoria-segura-aqui-cambiar

# Admin - CAMBIAR ANTES DE PRODUCCIÓN
ADMIN_EMAIL=admin@estrategia.site
ADMIN_PASSWORD=contraseña-segura-cambiar

# Mercado Pago (Credenciales REALES de producción, no sandbox)
MP_ACCESS_TOKEN=tu-access-token-real-aqui

# PayPal (Credenciales REALES de producción, no sandbox)
PAYPAL_CLIENT_ID=tu-client-id-real-aqui
PAYPAL_CLIENT_SECRET=tu-secret-real-aqui

# SendGrid Email API
SENDGRID_API_KEY=SG.tu-api-key-aqui

# SMTP Configuration (SendGrid)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=SG.tu-api-key-igual-que-arriba
SMTP_FROM=noreply@estrategia.site

# URLs
PUBLIC_BASE_URL=https://estrategia.site

# Conversión de moneda
ARS_PER_USD=1450
ARS_PER_EUR=1650
